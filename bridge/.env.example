# ============================================
# 法学攻防分析桥接服务 - 环境变量模板
# 使用方法：cp .env.example .env 然后填入真实值
# 注意：.env 已加入 .gitignore，严禁提交到 GitHub
# ============================================

# DeepSeek API 密钥（OpenAI 兼容），获取地址：https://platform.deepseek.com/api_keys
# 格式：sk- 开头的字符串
DEEPSEEK_API_KEY=

# 北大法宝 MCP Token（36 位），获取/查看地址：https://mcp.pkulaw.com/console
# 积分充值：https://mcp.pkulaw.com/console/points
PKULAW_TOKEN=
